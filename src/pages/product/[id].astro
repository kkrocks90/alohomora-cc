---
import { Image, getImage } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import products from "../../data/products.json";
import { productGallery, resolveImage } from "../../lib/product-images";
import { flavourExtra } from "../../lib/flavours";


export function getStaticPaths() {
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

const { product } = Astro.props;
const gallery = productGallery(product);
const image = gallery[0];
const related = [
  ...products.filter((other) => other.id !== product.id && other.tag === product.tag),
  ...products.filter((other) => other.id !== product.id && other.tag !== product.tag),
].slice(0, 4);
const base = import.meta.env.BASE_URL;
const checkoutApiUrl = import.meta.env.PUBLIC_CHECKOUT_API_URL?.trim() ?? "";
const shareImage = await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpeg", quality: 82 });
const productLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: product.name,
    description: product.description,
    image: new URL(shareImage.src, Astro.site).href,
    category: product.tag,
    brand: { "@type": "Brand", name: "Chocolate Circle" },
    offers: {
      "@type": "Offer",
      url: new URL(Astro.url.pathname, Astro.site).href,
      priceCurrency: "INR",
      price: String(product.price),
      availability: "https://schema.org/InStock",
      seller: { "@type": "Organization", name: "Chocolate Circle" },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Shop", item: new URL("/store/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: product.name },
    ],
  },
];
const customizable = product.customizable !== false;
---

<SiteLayout
  title={`${product.name} — Chocolate Circle`}
  description={`${product.description} ₹${product.price}, ${product.packSize}.${customizable ? " Handmade with a personalised wrapper." : " Handmade in small batches."}`}
  socialImage={shareImage.src}
  socialImageAlt={`${product.name} by Chocolate Circle`}
  ogType="product"
  jsonLd={productLd}
>
  <main class="product-detail-page" id="storefront" data-checkout-api={checkoutApiUrl}>
    <nav class="product-breadcrumb" aria-label="Breadcrumb">
      <a href={`${base}store/`}>Shop all treats</a>
      <span aria-hidden="true">/</span>
      <span>{product.name}</span>
    </nav>
    <article class="product-detail">
      <div class="product-detail-image" data-gallery>
        <div class="gallery-track" data-gallery-track tabindex="-1">
          {gallery.map((photo, photoIndex) => (
            <div class="gallery-slide" data-gallery-slide aria-label={`Photo ${photoIndex + 1} of ${gallery.length}`}>
              <Image
                src={photo}
                alt={`${product.name}, handmade by Chocolate Circle${gallery.length > 1 ? ` (photo ${photoIndex + 1})` : ""}`}
                width={800}
                height={720}
                widths={[400, 600, 800]}
                sizes="(max-width: 760px) 100vw, 50vw"
                format="webp"
                quality={84}
                priority={photoIndex === 0}
                loading={photoIndex === 0 ? "eager" : "lazy"}
              />
            </div>
          ))}
        </div>
        <span class="product-tag">{product.tag}</span>
        {gallery.length > 1 && (
          <>
            <button class="gallery-arrow gallery-arrow-prev" type="button" data-gallery-prev aria-label="Previous photo">&#8249;</button>
            <button class="gallery-arrow gallery-arrow-next" type="button" data-gallery-next aria-label="Next photo">&#8250;</button>
            <div class="gallery-dots" role="group" aria-label="Choose photo">
              {gallery.map((_, dotIndex) => (
                <button class="gallery-dot" type="button" data-gallery-dot={dotIndex} aria-label={`Show photo ${dotIndex + 1}`}></button>
              ))}
            </div>
          </>
        )}
      </div>
      <div class="product-detail-copy">
        <p class="eyebrow">Handmade in small batches</p>
        <h1>{product.name}</h1>
        <p class="product-detail-description">{product.description}</p>
        {(product.dimensions || product.weight) && (
          <dl class="product-specs">
            {product.dimensions && <div><dt>Dimensions</dt><dd>{product.dimensions}</dd></div>}
            {product.weight && <div><dt>Weight</dt><dd>{product.weight}</dd></div>}
          </dl>
        )}
        <div class="product-detail-price">
          <strong data-price-now={product.price}>₹{product.price}</strong>
          <span>{product.packSize}</span>
        </div>
        <div class="product-actions">
          <button class="product-action" type="button" data-wish={product.id} data-wish-name={product.name} aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.5s-7.5-4.6-7.5-10A4.5 4.5 0 0 1 12 7.8a4.5 4.5 0 0 1 7.5 2.7c0 5.4-7.5 10-7.5 10z"></path></svg>
            <span>Wishlist</span>
          </button>
          <button class="product-action" type="button" data-share data-share-title={product.name} data-share-text={`${product.name} by Chocolate Circle, from \u20B9${product.price}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="6" cy="12" r="2.5"></circle><circle cx="17" cy="6" r="2.5"></circle><circle cx="17" cy="18" r="2.5"></circle><path d="m8.2 10.8 6.6-3.6M8.2 13.2l6.6 3.6"></path></svg>
            <span data-share-label>Share</span>
          </button>
        </div>
        <p class="product-option-note">
          {customizable
            ? <>Choose your quantity{product.flavours.length > 0 && ", flavour"} and any personalisation options.</>
            : <>Choose your quantity. The chocolate selection is decided by us.</>}
        </p>
        <form class="product-options" id="product-options-form">
          <label>
            Quantity
            <select name="quantity" required>
              {Array.from({ length: 20 }, (_, index) => (
                <option value={index + 1} selected={index === 0}>{index + 1}</option>
              ))}
            </select>
          </label>
          {product.flavours.length > 0 && (
            <label>
              Flavour <span>Required</span>
              <select name="flavour" required>
                <option value="" disabled selected>Choose a flavour</option>
                {product.flavours.map((flavour) => {
                  const extra = flavourExtra(flavour);
                  return <option value={flavour} data-extra={extra}>{extra > 0 ? `${flavour} (+${extra}%)` : flavour}</option>;
                })}
              </select>
            </label>
          )}
          <div class="custom-fields" id="product-custom-fields" hidden></div>
          <button
            class="button button-primary product-add-button"
            type="button"
            data-add-to-cart={product.id}
            aria-label={`Add to bag: ${product.name}`}
          >
            Add to bag <span aria-hidden="true">+</span>
          </button>
        </form>
        <ul class="product-trust" aria-label="Why customers love us">
          <li><span aria-hidden="true">🍫</span> Handmade in small batches</li>
          <li><span aria-hidden="true">🎁</span> {customizable ? "Personalised wrapper" : "Gift-ready box"}</li>
          <li><span aria-hidden="true">🚚</span> Delivery across India</li>
          <li><span aria-hidden="true">🔒</span> Secure Razorpay payment</li>
        </ul>
        <p class="product-lead-time">Please allow 3 to 4 days for preparation. Planning an event? Add the date at checkout.</p>
      </div>
    </article>
    {related.length > 0 && (
      <section class="product-related" aria-labelledby="related-title">
        <h2 id="related-title">You may also <em>like</em></h2>
        <div class="product-grid product-related-grid">
          {related.map((other, index) => {
            return <ProductCard product={other} image={resolveImage(other.image)} index={index + 4} />;
          })}
        </div>
      </section>
    )}
    <a class="product-back-link" href={`${base}store/`}>← Back to all treats</a>
  </main>
</SiteLayout>

<script>
  import "../../scripts/flat-discount-prices";
  const priceEl = document.querySelector<HTMLElement>("[data-price-now]");
  const flavourSelect = document.querySelector<HTMLSelectElement>("#product-options-form select[name=flavour]");
  if (priceEl && flavourSelect) {
    const basePrice = Number(priceEl.dataset.priceNow);
    flavourSelect.addEventListener("change", () => {
      const extra = Number(flavourSelect.selectedOptions[0]?.dataset.extra ?? 0) || 0;
      const price = Math.round((basePrice * (100 + extra)) / 100);
      priceEl.dataset.priceNow = String(price);
      priceEl.textContent = `\u20B9${price}`;
      priceEl.dispatchEvent(new CustomEvent("cc:price", { bubbles: true }));
    });
  }
  const gallery =  document.querySelector<HTMLElement>("[data-gallery]");
  const track = gallery?.querySelector<HTMLElement>("[data-gallery-track]");
  if (gallery && track) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
    const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-dot]"));
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const show = (index: number) => {
      const next = (index + slides.length) % slides.length;
      track.scrollTo({ left: next * track.clientWidth, behavior: "smooth" });
    };
    const sync = () => {
      const index = current();
      dots.forEach((dot, dotIndex) => dot.setAttribute("aria-current", String(dotIndex === index)));
    };
    track.addEventListener("scroll", sync, { passive: true });
    gallery.querySelector("[data-gallery-prev]")?.addEventListener("click", () => show(current() - 1));
    gallery.querySelector("[data-gallery-next]")?.addEventListener("click", () => show(current() + 1));
    dots.forEach((dot, dotIndex) => dot.addEventListener("click", () => show(dotIndex)));
    gallery.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(current() - 1);
      if (event.key === "ArrowRight") show(current() + 1);
    });
    sync();
  }
</script>
