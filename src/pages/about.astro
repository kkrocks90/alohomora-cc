---
import SiteLayout from "../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL;
const faqs = [
  {
    q: "Where is Chocolate Circle based and do you deliver across India?",
    a: "We are a small-batch handmade chocolate shop based in Chennai, Tamil Nadu. We can arrange delivery across India wherever a courier can serve your address.",
  },
  {
    q: "How much notice do you need for an order?",
    a: "Please allow at least 3 to 4 days for preparation. For an event, we plan delivery for two days before the event or on the event date, depending on your location.",
  },
  {
    q: "Can I personalise the wrapper on my chocolates?",
    a: "Yes. Many products offer a personalised wrapper; choose the option on the product page.",
  },
  {
    q: "Do you take bulk or corporate gifting orders?",
    a: "Yes. We make hampers and bulk orders for festivals, weddings, birthdays and corporate gifting. See our Corporate page or message us on WhatsApp.",
  },
  {
    q: "How can I contact Chocolate Circle?",
    a: "Email customer.support@chocolatecircle.in or WhatsApp +91 95008 68468.",
  },
];
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<SiteLayout
  title="About us — Chocolate Circle"
  description="Meet Chocolate Circle, a small-batch handmade chocolate shop based in Chennai."
  jsonLd={[faqLd]}
>
  <main class="policy-page about-page">
    <header class="policy-heading">
      <p class="eyebrow">A little about us</p>
      <h1>Made by hand.<br /><em>Shared with love.</em></h1>
    </header>

    <article class="policy-content">
      <p>
        Chocolate Circle is a small-batch handmade chocolate shop from Chennai, operated by
        Alohomora Chocolate Circle. We make thoughtful chocolate treats for everyday moments,
        celebrations, and the people you love.
      </p>

      <h2>Small batches, personal touches</h2>
      <p>
d make our chocolates by hand in small batches rather than mass-producing them. Choose
        from the treats on our shelf, explore available flavours, and add a personal wrapper
        touch where offered. Each order gets care from preparation through packing.
      </p>

      <h2>Made with your occasion in mind</h2>
      <p>
        Planning for a birthday, celebration, or a just-because gift? Please allow at least 3 to
        4 days for preparation. If you add an event date, we’ll discuss delivery for two days
        before the event or on the event date, depending on your location and the delivery
        arrangement.
      </p>

      <h2>From Chennai to your doorstep</h2>
      <p>
d’re based in Chennai and can arrange delivery across India where a courier can serve
        your address. Delivery options and the fee are discussed with you after you place an
        order, before dispatch.
      </p>

      <p>
d’d love to help with an order or a question. Reach us at
        <a href="mailto:customer.support@chocolatecircle.in">customer.support@chocolatecircle.in</a>
        or on <a href="https://wa.me/919500868468">WhatsApp at +91 95008 68468</a>.
      </p>
      <h2>Frequently asked questions</h2>
      {faqs.map((item) => (
        <>
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </>
      ))}
      <p>
        <a class="button button-primary" href={`${base}store/`}>
          Find your chocolate <span aria-hidden="true">↗</span>
        </a>
      </p>
    </article>
  </main>
</SiteLayout>
