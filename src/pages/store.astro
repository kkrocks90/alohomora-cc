---
import { Image, type ImageMetadata } from "astro:assets";
import ProductCard from "../components/ProductCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import products from "../data/products.json";

const productImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/products/*.{jpg,jpeg,png,webp,svg}",
  {
    eager: true,
  },
);
const imagesByName = Object.fromEntries(
  Object.entries(productImages).map(([path, image]) => [path.split("/").pop(), image.default]),
);
const tags = [...new Set(products.map((product) => product.tag))].sort((a, b) => a.localeCompare(b));
const checkoutApiUrl = import.meta.env.PUBLIC_CHECKOUT_API_URL?.trim() ?? "";
---

<SiteLayout title="Shop all treats — Chocolate Circle" description="Browse handmade Chocolate Circle treats. Filter and sort the full product collection.">
  <main class="store-page" id="storefront" data-checkout-api={checkoutApiUrl}>
    <section class="store-heading">
      <p class="eyebrow">The whole treats shelf</p>
      <h1>Find your <em>sweet spot.</em></h1>
      <p>Handmade chocolates, candies, and gifts, ready to make someone’s day.</p>
    </section>
    <div class="promo-banner promo-banner-ribbon" data-promo-banner hidden>
      <span class="promo-banner-sparkle" aria-hidden="true">✳</span>
      <span class="promo-banner-copy">
        <span class="promo-banner-kicker">Today’s sweet deal</span>
        <strong data-promo-name></strong>
        <span data-promo-offer></span>
      </span>
      <button class="promo-banner-code" type="button" data-promo-copy>Use code <strong data-promo-code></strong></button>
    </div>

    <section class="store-results" id="store-catalog" aria-label="Shop products">
      <div class="store-toolbar-wrap">
        <div class="store-toolbar">
          <label class="store-search">
            <span class="store-label-hidden">Search products</span>
            <svg class="store-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m20 20-4.2-4.2"></path></svg>
            <input id="store-search" type="search" placeholder="Search chocolates, hampers…" autocomplete="off" enterkeyhint="search" />
            <button class="store-search-clear" id="store-search-clear" type="button" aria-label="Clear search" hidden>×</button>
          </label>
          <label class="store-sort">
            <span class="store-label-hidden">Sort by</span>
            <select id="store-sort">
              <option value="featured">Featured</option>
              <option value="price-low">Price: low to high</option>
              <option value="price-high">Price: high to low</option>
              <option value="name">Name: A to Z</option>
            </select>
          </label>
          <label class="store-label-hidden">
            <span>Filter by</span>
            <select id="store-filter" tabindex="-1">
              <option value="">All products</option>
              {tags.map((tag) => <option value={tag}>{tag}</option>)}
            </select>
          </label>
        </div>
        <div class="store-chips" id="store-chips" role="group" aria-label="Filter by category">
          <button class="store-chip is-active" type="button" data-chip="" aria-pressed="true">All</button>
          {tags.map((tag) => <button class="store-chip" type="button" data-chip={tag} aria-pressed="false">{tag}</button>)}
        </div>
      </div>

      <p class="store-count" id="store-count" role="status" aria-live="polite"></p>
      <div class="product-grid store-grid" id="store-grid">
        {products.map((product, index) => {
          const image = imagesByName[product.image];
          if (!image) throw new Error(`Product image not found: ${product.image}`);
          return <ProductCard product={product} image={image} index={index} />;
        })}
      </div>
      <div class="store-empty" id="store-empty" hidden>
        <p>No treats match those choices.</p>
        <button class="button button-primary" id="store-reset" type="button">Clear search &amp; filters</button>
      </div>
      <div class="store-load-area">
        <span id="store-scroll-sentinel" aria-hidden="true"></span>
        <button class="button button-primary store-load-more" id="store-load-more" type="button">
          Load more products <span aria-hidden="true">↓</span>
        </button>
        <p class="store-loading" id="store-loading" role="status" aria-live="polite" hidden>
          <span class="store-loading-spinner" aria-hidden="true"></span>
          Loading more products…
        </p>
      </div>
    </section>
  </main>
  <script>
    import "../scripts/catalog";
    import "../scripts/promos";
  </script>
</SiteLayout>
