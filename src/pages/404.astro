---
import SiteLayout from "../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL;
---

<SiteLayout title="Page not found — Chocolate Circle" description="This page could not be found." noIndex>
  <main class="not-found-page">
    <div class="not-found-card">
      <span class="not-found-code" aria-hidden="true">404</span>
      <p class="eyebrow">Oops, a missing treat</p>
      <h1>We couldn’t find <em>that page.</em></h1>
      <p>The link may be old or mistyped. Let’s get you back to something sweet.</p>
      <div class="not-found-actions">
        <a class="button button-primary" href={`${base}store/`}>Shop all treats <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={base}>Back to home <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </main>
</SiteLayout>
