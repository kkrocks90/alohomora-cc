---
import SiteLayout from "../layouts/SiteLayout.astro";

const checkoutApiUrl = import.meta.env.PUBLIC_CHECKOUT_API_URL?.trim() ?? "";
const base = import.meta.env.BASE_URL;
---

<SiteLayout
  title="Checkout — Chocolate Circle"
  description="Sign in to enter your details and place your Chocolate Circle order."
  noIndex
>
  <main
    class="checkout-page"
    id="checkout-page"
    data-checkout-api={checkoutApiUrl}
    data-base-url={base}
  >
    <nav class="product-breadcrumb" aria-label="Breadcrumb">
      <a href={`${base}store/`}>Shop all treats</a>
      <span aria-hidden="true">/</span>
      <span>Checkout</span>
    </nav>
    <section class="checkout-heading">
      <p class="eyebrow">One last little step</p>
      <h1>Secure <em>checkout.</em></h1>
      <p>Sign in with your email first. Your bag stays saved while you check out.</p>
    </section>

    <section class="checkout-login checkout-panel" id="checkout-login" aria-labelledby="checkout-login-title">
      <p class="eyebrow">Your email, your order</p>
      <h2 id="checkout-login-title">Sign in to continue</h2>
      <p>We’ll email you a one-time code to confirm it’s you and keep your order history together.</p>
      <form class="account-form" id="checkout-email-form">
        <label for="checkout-email">Email address</label>
        <input
          id="checkout-email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="120"
          required
        />
        <label class="remember-me-option" for="checkout-remember-me">
          <input id="checkout-remember-me" name="rememberMe" type="checkbox" />
          <span>Remember me on this device</span>
        </label>
        <button class="button button-primary" type="submit">Email me a sign-in code <span aria-hidden="true">↗</span></button>
      </form>
      <form class="account-form" id="checkout-code-form" hidden>
        <label for="checkout-code">Six-digit code</label>
        <input
          id="checkout-code"
          name="code"
          type="text"
          inputmode="numeric"
          autocomplete="one-time-code"
          pattern="[0-9]{6}"
          maxlength="6"
          required
        />
        <button class="button button-primary" type="submit">Verify and continue <span aria-hidden="true">↗</span></button>
        <button class="account-text-button" id="checkout-change-email" type="button">Use a different email</button>
      </form>
      <p class="account-status" id="checkout-login-status" role="status" aria-live="polite"></p>
    </section>

    <section class="checkout-profile-setup checkout-panel" id="checkout-profile-setup" hidden aria-labelledby="checkout-profile-title">
      <p class="eyebrow">A quick introduction</p>
      <h2 id="checkout-profile-title">Create your customer profile</h2>
      <p>Save your name, mobile number, and default delivery address. You can edit these details for every checkout.</p>
      <form class="account-form" id="checkout-profile-form">
        <label for="checkout-profile-name">Name</label>
        <input id="checkout-profile-name" name="name" autocomplete="name" maxlength="80" required />
        <label for="checkout-profile-phone">Mobile number</label>
        <input id="checkout-profile-phone" name="phone" type="tel" autocomplete="tel" maxlength="20" required />
        <label for="checkout-profile-address">Default delivery address</label>
        <textarea id="checkout-profile-address" name="address" autocomplete="street-address" rows="3" maxlength="250" required></textarea>
        <button class="button button-primary" type="submit">Save details and continue <span aria-hidden="true">↗</span></button>
      </form>
      <p class="account-status" id="checkout-profile-status" role="status" aria-live="polite"></p>
    </section>

    <section class="checkout-content" id="checkout-content" hidden aria-labelledby="checkout-title">
      <div class="checkout-main">
        <div class="checkout-panel checkout-customer-panel">
          <div class="checkout-panel-heading">
            <div>
              <p class="eyebrow">Signed in</p>
              <h2 id="checkout-title">Delivery details</h2>
              <p class="checkout-signed-in" id="checkout-signed-in"></p>
            </div>
            <button class="account-text-button" id="checkout-sign-out" type="button">Sign out</button>
          </div>
          <form class="checkout-form" id="checkout-form">
            <label>
              Your name
              <input name="name" autocomplete="name" maxlength="80" required />
            </label>
            <label>
              Phone number
              <input name="phone" type="tel" autocomplete="tel" maxlength="20" required />
            </label>
            <label>
              Delivery address
              <textarea name="address" autocomplete="street-address" rows="3" maxlength="250" required></textarea>
            </label>
            <label>
              Event date <span class="optional-label">(optional)</span>
              <input name="eventDate" type="date" autocomplete="off" />
              <span class="location-privacy">Choose the date you’d like your chocolates for.</span>
            </label>
            <fieldset class="delivery-location">
              <legend>Delivery location</legend>
              <p>
                We use your delivery pin to estimate the distance from the shop and suggest Porter
                or a courier. Nothing is booked automatically.
              </p>
              <button class="location-button" id="use-delivery-location" type="button">
                Use this device’s location
              </button>
              <span class="location-or">or enter a map pin’s coordinates</span>
              <a class="map-help-link" href="https://maps.google.com/" target="_blank" rel="noreferrer">
                Open Google Maps to find your delivery pin ↗
              </a>
              <span class="location-privacy">
                Long-press the delivery address on the map to drop a pin, then enter its latitude
                and longitude below.
              </span>
              <div class="coordinate-fields">
                <label>
                  Latitude
                  <input name="latitude" type="number" inputmode="decimal" step="any" min="-90" max="90" required />
                </label>
                <label>
                  Longitude
                  <input name="longitude" type="number" inputmode="decimal" step="any" min="-180" max="180" required />
                </label>
              </div>
              <span class="location-privacy">
                Use the delivery address pin, not your current location if it’s somewhere else.
                Coordinates are used only to estimate delivery distance.
              </span>
            </fieldset>
            <label class="policy-consent">
              <input name="policyConsent" type="checkbox" required />
              <span>
                I agree to the <a href={`${base}terms-and-conditions/`}>Terms &amp; Conditions</a>,
                <a href={`${base}privacy-policy/`}>Privacy Policy</a>, and
                <a href={`${base}shipping-policy/`}>Shipping Policy</a>.
              </span>
            </label>
            <button class="button button-primary checkout-button" id="checkout-button" type="submit">
              Continue to secure payment <span aria-hidden="true">↗</span>
            </button>
          </form>
          <p class="checkout-status" id="checkout-status" role="status" aria-live="polite"></p>
          <p class="payment-footnote">Secure checkout by Razorpay · Your payment details never touch our website.</p>
        </div>
      </div>

      <aside class="checkout-panel checkout-order-panel" aria-labelledby="checkout-order-title">
        <p class="eyebrow">A little something lovely</p>
        <h2 id="checkout-order-title">Your order</h2>
        <div class="checkout-order-items" id="checkout-order-items"></div>
        <div class="subtotal-row checkout-subtotal">
          <span>Product subtotal</span>
          <strong id="checkout-total">₹0</strong>
        </div>
        <p class="delivery-note">
          Delivery arrangements and any delivery charge will be confirmed separately and are not
          included in this payment.
        </p>
        <a class="text-link" href={`${base}store/`}>Continue shopping <span aria-hidden="true">→</span></a>
      </aside>
    </section>
    <section class="checkout-empty checkout-panel" id="checkout-empty" hidden>
      <h2>Your bag is empty</h2>
      <p>Add a handmade treat before continuing to checkout.</p>
      <a class="button button-primary" href={`${base}store/`}>Shop all treats <span aria-hidden="true">↗</span></a>
    </section>
  </main>
  <script>
    import "../scripts/checkout";
  </script>
</SiteLayout>
