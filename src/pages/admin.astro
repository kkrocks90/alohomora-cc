---
import AdminLayout from "../layouts/AdminLayout.astro";
import StateSelect from "../components/StateSelect.astro";

const checkoutApiUrl = import.meta.env.PUBLIC_CHECKOUT_API_URL?.trim() ?? "";
---

<AdminLayout
  title="Order management — Chocolate Circle"
  description="Private Chocolate Circle customer and order management."
  noIndex
>
  <main class="admin-page" id="admin-app" data-checkout-api={checkoutApiUrl}>
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("cocoa-kind-admin-session") || sessionStorage.getItem("cocoa-kind-admin-session")) {
            document.currentScript.parentElement.classList.add("is-session-loading");
          }
        } catch (e) {}
      })();
    </script>
    <div class="session-loader" role="status" aria-live="polite"><span class="session-loader-spinner" aria-hidden="true"></span><span>Opening dashboard…</span></div>
    <section class="admin-login-panel" id="admin-login-panel" aria-labelledby="admin-title">
      <p class="eyebrow">Chocolate Circle · private</p>
      <h1 id="admin-title">Order <em>management.</em></h1>
      <p class="admin-intro">Sign in with the shop admin email to manage customers, orders, and invoices.</p>
      <div class="google-signin" id="admin-google" hidden></div>
      <form class="account-form" id="admin-email-form">
        <label for="admin-email">Admin email address</label>
        <input id="admin-email" name="email" type="email" autocomplete="email" maxlength="120" required />
        <button class="button button-primary" type="submit">Send sign-in code <span aria-hidden="true">↗</span></button>
      </form>
      <form class="account-form" id="admin-code-form" hidden>
        <label for="admin-code">Six-digit code</label>
        <input
          id="admin-code"
          name="code"
          type="text"
          inputmode="numeric"
          autocomplete="one-time-code"
          pattern="[0-9]{6}"
          maxlength="6"
          required
        />
        <button class="button button-primary" type="submit">Open admin dashboard <span aria-hidden="true">↗</span></button>
        <button class="account-text-button" id="admin-change-email" type="button">Use a different email</button>
      </form>
      <p class="account-status" id="admin-login-status" role="status" aria-live="polite"></p>
    </section>

    <section class="admin-dashboard" id="admin-dashboard" hidden>
      <div class="admin-dashboard-heading">
        <div>
          <p class="eyebrow">Chocolate Circle</p>
          <h1>Orders &amp; <em>customers.</em></h1>
          <p class="admin-signed-in" id="admin-signed-in"></p>
        </div>
        <div class="admin-heading-actions">
          <a class="button button-secondary admin-desktop-only" href={import.meta.env.BASE_URL}>View store ↗</a>
          <button class="button button-secondary" id="admin-refresh" type="button">Refresh</button>
          <button class="account-text-button admin-desktop-only" id="admin-sign-out" type="button">Sign out</button>
        </div>
      </div>
      <p class="admin-status" id="admin-status" role="status" aria-live="polite"></p>

      <div class="admin-menu-backdrop" id="admin-menu-backdrop" hidden></div>
      <div class="admin-tabs" id="admin-tabs" role="tablist" aria-label="Order management sections">
        <div class="admin-menu-heading">
          <p class="eyebrow">Admin sections</p>
          <button class="icon-button" id="admin-menu-close" type="button" aria-label="Close admin menu">&times;</button>
        </div>
        <button
          class="admin-tab"
          id="admin-dashboard-tab"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="admin-dashboard-panel"
          tabindex="0"
          data-admin-tab="dashboard"
        >Dashboard</button>
        <button
          class="admin-tab"
          id="admin-orders-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="admin-orders-panel"
          tabindex="-1"
          data-admin-tab="orders"
        >Order book</button>
        <button
          class="admin-tab"
          id="admin-customers-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="admin-customers-panel"
          tabindex="-1"
          data-admin-tab="customers"
        >Customers</button>
        <button
          class="admin-tab"
          id="admin-create-order-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="admin-create-order-panel"
          tabindex="-1"
          data-admin-tab="create-order"
        >Create manual order</button>
        <button
          class="admin-tab"
          id="admin-promos-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="admin-promos-panel"
          tabindex="-1"
          data-admin-tab="promos"
        >Promo codes</button>
        <button
          class="admin-tab"
          id="admin-fields-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="admin-fields-panel"
          tabindex="-1"
          data-admin-tab="fields"
        >Custom fields</button>
        <button
          class="admin-tab"
          id="admin-products-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="admin-products-panel"
          tabindex="-1"
          data-admin-tab="products"
        >Products</button>
        <button
          class="admin-tab"
          id="admin-categories-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="admin-categories-panel"
          tabindex="-1"
          data-admin-tab="categories"
        >Product categories</button>
        <button
          class="admin-tab"
          id="admin-flavours-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="admin-flavours-panel"
          tabindex="-1"
          data-admin-tab="flavours"
        >Flavours</button>
        <button
          class="admin-tab"
          id="admin-delivery-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="admin-delivery-panel"
          tabindex="-1"
          data-admin-tab="delivery"
        >Delivery charges</button>
        <button
          class="admin-tab"
          id="admin-reviews-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="admin-reviews-panel"
          tabindex="-1"
          data-admin-tab="reviews"
        >Reviews</button>
        <div class="admin-menu-foot">
          <a href={import.meta.env.BASE_URL}>View store ↗</a>
          <button type="button" id="admin-menu-signout">Sign out</button>
        </div>
      </div>

      <section
        class="admin-tab-panel"
        id="admin-dashboard-panel"
        role="tabpanel"
        aria-labelledby="admin-dashboard-tab"
        data-admin-panel="dashboard"
        tabindex="0"
      >
        <section class="admin-panel" aria-labelledby="admin-dashboard-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">At a glance</p>
              <h2 id="admin-dashboard-title">Dashboard</h2>
            </div>
          </div>
          <div class="admin-stats" id="admin-stats" aria-label="Order summary"></div>
          <div class="dash-grid" id="admin-insights"></div>
        </section>
      </section>

      <section
        class="admin-tab-panel"
        id="admin-orders-panel"
        role="tabpanel"
        aria-labelledby="admin-orders-tab"
        data-admin-panel="orders"
        tabindex="0"
        hidden
      >
        <section class="admin-panel" aria-labelledby="admin-orders-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">Latest activity</p>
              <h2 id="admin-orders-title">Order book</h2>
            </div>
          </div>
          <div class="admin-list-tools">
            <label>Search orders<input id="admin-order-search" type="search" placeholder="Order ID, customer, phone, or email" autocomplete="off" /></label>
            <fieldset class="admin-status-filter" id="admin-order-status-filter"><legend>Show orders</legend><div class="admin-status-checks" id="admin-order-status-checks"></div></fieldset>
            <p class="admin-list-count" id="admin-order-count" aria-live="polite"></p>
          </div>
          <div class="admin-order-list" id="admin-order-list"></div>
          <nav class="admin-pagination" id="admin-order-pagination" aria-label="Order pages"></nav>
        </section>
      </section>

      <section
        class="admin-tab-panel"
        id="admin-promos-panel"
        role="tabpanel"
        aria-labelledby="admin-promos-tab"
        data-admin-panel="promos"
        tabindex="0"
        hidden
      >
        <section class="admin-panel" aria-labelledby="admin-flat-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">Sitewide offer</p>
              <h2 id="admin-flat-title">Flat discount</h2>
            </div>
          </div>
          <p class="admin-form-hint">A percentage taken off every order automatically, and shown on the home page. While it is live, promo codes cannot be used.</p>
          <p class="admin-flat-summary" id="admin-flat-summary" role="status"></p>
          <form class="admin-flat-form" id="admin-flat-form">
            <label>Name<input name="name" maxlength="60" required placeholder="Diwali sale" /></label>
            <label>Percentage off<input name="percentage" type="number" min="1" max="90" step="1" required placeholder="10" inputmode="numeric" /></label>
            <label>Ends on (optional)<input name="endDate" type="date" /></label>
            <label class="admin-flat-toggle"><input name="active" type="checkbox" /> Turn on</label>
            <button class="button button-primary" type="submit">Save flat discount</button>
          </form>
        </section>
        <section class="admin-panel" aria-labelledby="admin-promos-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">Customer offers</p>
              <h2 id="admin-promos-title">Create promo code</h2>
            </div>
          </div>
          <p class="admin-form-hint">Codes are generated automatically. Limited-use codes are reserved during checkout and count once per signed-in customer after a successful order.</p>
          <form class="admin-promo-form apf-form" id="admin-promo-form">
            <section class="apf-card"><h3>Offer</h3>
            <label>Promo name<input name="name" maxlength="80" required placeholder="Summer chocolate treat" /></label>
            <label>Discount type<select name="type" id="admin-promo-type" required>
              <option value="percentage">Percentage off</option>
              <option value="fixed">Fixed amount off subtotal</option>
            </select></label>
            <div class="admin-promo-fields" id="admin-promo-percentage-fields">
              <label>Percentage off<input name="percentage" type="number" min="1" max="100" step="1" value="10" required /></label>
              <label>Applies to<select name="targetType" id="admin-promo-target-type">
                <option value="all">All products</option>
                <option value="product">One product</option>
                <option value="category">One category</option>
              </select></label>
              <label id="admin-promo-target-value-label" hidden>Product or category<select name="targetValue" id="admin-promo-target-value" disabled></select></label>
            </div>
            <div class="admin-promo-fields" id="admin-promo-fixed-fields" hidden>
              <label>Amount off (₹)<input name="amountRupees" type="number" min="1" max="1000000" step="1" value="100" disabled required /></label>
              <label>Product subtotal must be greater than (₹)<input name="minimumRupees" type="number" min="0" max="1000000" step="1" value="0" disabled required /></label>
            </div>
            </section>
            <section class="apf-card"><h3>Limits</h3>
            <div class="admin-promo-limits">
              <label>Maximum distinct customers (optional)<input name="maxRedemptions" type="number" min="1" max="1000000" step="1" placeholder="No limit" /></label>
              <label>End date (optional)<input name="endDate" type="date" /></label>
            </div>
            </section>
            <div class="apf-actions"><button class="button button-primary" type="submit">Generate promo code</button></div>
          </form>
          <div class="admin-promo-list" id="admin-promo-list" aria-live="polite"></div>
        </section>
      </section>

      <section
        class="admin-tab-panel"
        id="admin-fields-panel"
        role="tabpanel"
        aria-labelledby="admin-fields-tab"
        data-admin-panel="fields"
        tabindex="0"
        hidden
      >
        <section class="admin-panel" aria-labelledby="admin-fields-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">Extra questions</p>
              <h2 id="admin-fields-title">Custom fields</h2>
            </div>
          </div>
          <p class="admin-form-hint">Add extra questions customers answer. <strong>Product fields</strong> appear on the product page and are saved for each item in the bag. <strong>Checkout fields</strong> are asked once per order. Answers appear on the order, invoice, and WhatsApp share.</p>
          <form class="admin-promo-form admin-field-form apf-form" id="admin-field-form">
            <section class="apf-card"><h3>Question</h3>
            <label>Field label<input name="label" maxlength="80" required placeholder="Gift message" /></label>
            <label>Where it appears<select name="scope" id="admin-field-scope" required>
              <option value="product">Product detail page</option>
              <option value="checkout">Checkout</option>
            </select></label>
            <label>Input type<select name="type" id="admin-field-type" required></select></label>
            <label id="admin-field-options-label" hidden>Options (one per line)<textarea name="options" id="admin-field-options" rows="4" placeholder="Option one&#10;Option two"></textarea></label>
            <div class="admin-field-range" id="admin-field-range" hidden>
              <label>Minimum<input name="min" type="number" step="any" /></label>
              <label>Maximum<input name="max" type="number" step="any" /></label>
            </div>
            <label class="admin-field-check" id="admin-field-future-label" hidden><input name="futureOnly" type="checkbox" /> Only allow today or later</label>
            </section>
            <section class="apf-card"><h3>Display</h3>
            <label id="admin-field-placeholder-label">Placeholder (optional)<input name="placeholder" maxlength="80" /></label>
            <label>Help text (optional)<input name="helpText" maxlength="200" /></label>
            <label class="admin-field-check"><input name="required" type="checkbox" /> Customers must answer this</label>
            <label>Display order<input name="sortOrder" type="number" step="1" min="-1000" max="1000" value="0" /></label>
            </section>
            <section class="apf-card"><h3>Where it applies</h3>
            <div class="admin-field-targets" id="admin-field-targets">
              <label>Applies to<select name="appliesMode" id="admin-field-applies-mode">
                <option value="all">All products</option>
                <option value="categories">Selected categories</option>
                <option value="products">Selected products</option>
              </select></label>
              <fieldset id="admin-field-applies-values" hidden>
                <legend id="admin-field-applies-legend">Choose</legend>
                <div class="admin-field-applies-list" id="admin-field-applies-list"></div>
              </fieldset>
            </div>
            </section>
            <div class="admin-form-actions apf-actions">
              <button class="button button-primary" id="admin-field-submit" type="submit">Create field</button>
              <button class="button button-secondary" id="admin-field-cancel" type="button" hidden>Cancel edit</button>
            </div>
          </form>
          <div class="admin-field-list" id="admin-field-list" aria-live="polite"></div>
        </section>
      </section>

      <section
        class="admin-tab-panel"
        id="admin-products-panel"
        role="tabpanel"
        aria-labelledby="admin-products-tab"
        data-admin-panel="products"
        tabindex="0"
        hidden
      >
        <section class="admin-panel" aria-labelledby="admin-product-form-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">Catalogue</p>
              <h2 id="admin-product-form-title">Add a product</h2>
            </div>
          </div>
          <form class="admin-product-form" id="admin-product-form">
            <section class="apf-card apf-photos" aria-labelledby="apf-photos-title">
              <h3 id="apf-photos-title">Photos <small>Up to 3 &middot; the first is the main photo</small></h3>
              <div class="admin-product-photos" id="admin-product-photos"></div>
              <input id="admin-product-photo-input" type="file" accept="image/jpeg,image/png,image/webp" multiple hidden />
              <p class="admin-form-hint">Shop and home pages show the main photo. Customers can flip through all photos on the product page.</p>
            </section>
            <section class="apf-card" aria-labelledby="apf-details-title">
              <h3 id="apf-details-title">Details</h3>
              <label>Product name<input name="name" maxlength="120" required placeholder="Dark Chocolate Truffles" /></label>
              <label>Description<textarea name="description" rows="3" maxlength="500" required placeholder="What makes this treat special"></textarea></label>
              <div class="apf-row">
                <label>Price<span class="apf-money"><span aria-hidden="true">&#8377;</span><input name="price" type="number" inputmode="numeric" min="1" max="100000" step="1" required /></span></label>
                <label>Pack size<input name="packSize" maxlength="60" placeholder="Box of 9" required /></label>
              </div>
              <div class="apf-row">
                <label>Dimensions of 1 piece <span class="apf-optional">Optional</span><input name="dimensions" maxlength="60" placeholder="12 x 8 cm (length x width)" /></label>
                <label>Weight of 1 piece <span class="apf-optional">Optional</span><input name="weight" maxlength="40" placeholder="8 g" /></label>
              </div>
              <p class="admin-form-hint">Enter size and weight for a single piece, not the whole pack. The pack weight is worked out from the pack size, e.g. 8 g in a "Pack of 40" is 320 g.</p>
              <label>Category<input name="tag" maxlength="60" list="admin-product-categories" required placeholder="Choose or type a new one" /></label>
              <datalist id="admin-product-categories"></datalist>
            </section>
            <section class="apf-card" aria-labelledby="apf-options-title">
              <h3 id="apf-options-title">Options</h3>
              <fieldset class="apf-flavours">
                <legend>Flavours <small>tick the ones customers can choose, optional</small></legend>
                <div class="apf-flavour-list" id="admin-product-flavours"></div>
              </fieldset>
              <label>Also show in <small>other categories, comma separated</small><input name="extraTags" /></label>
              <div class="apf-toggles">
                <label class="apf-toggle"><input name="active" type="checkbox" checked /><span><strong>Visible to customers</strong><small>Turn off to hide it from the shop</small></span></label>
                <label class="apf-toggle"><input name="featured" type="checkbox" /><span><strong>Feature on home page</strong><small>Shown in the featured slider</small></span></label>
                <label class="apf-toggle"><input name="customizable" type="checkbox" checked /><span><strong>Personalised wrapper</strong><small>Customers can customise the wrapper</small></span></label>
              </div>
            </section>
            <div class="apf-actions">
              <button class="button button-primary" id="admin-product-submit" type="submit">Add product</button>
              <button class="button button-secondary" id="admin-product-cancel" type="button" hidden>Cancel edit</button>
            </div>
          </form>
        </section>
        <section class="admin-panel" aria-labelledby="admin-product-list-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">Your products</p>
              <h2 id="admin-product-list-title">All products</h2>
            </div>
            <button class="button button-secondary" id="admin-product-publish" type="button">Publish to storefront</button>
          </div>
          <p class="admin-form-hint" id="admin-product-publish-hint"></p>
          <div class="admin-product-list" id="admin-product-list"></div>
        </section>
      </section>

      <section
        class="admin-tab-panel"
        id="admin-delivery-panel"
        role="tabpanel"
        aria-labelledby="admin-delivery-tab"
        data-admin-panel="delivery"
        tabindex="0"
        hidden
      >
        <section class="admin-panel" aria-labelledby="admin-delivery-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">Shipping</p>
              <h2 id="admin-delivery-title">Delivery charges</h2>
            </div>
          </div>
          <p class="admin-form-hint">Pickup is always free. Within the Porter radius we book a Porter; beyond it we send by courier, priced by weight and whether the customer is in your state. Rates are whole rupees.</p>
          <p class="admin-flat-summary" id="admin-delivery-summary" role="status"></p>
          <form class="admin-delivery-form apf-form" id="admin-delivery-form">
            <section class="apf-card dc-master">
              <label class="dc-switch">
                <span class="dc-switch-text"><strong>Charge for delivery</strong><small>When off, customers are not charged. You can still save and test the rules below.</small></span>
                <input name="enabled" type="checkbox" role="switch" />
                <span class="dc-switch-track" aria-hidden="true"></span>
              </label>
            </section>
            <section class="apf-card dc-porter">
              <h3><span aria-hidden="true">🏍️</span> Porter <small>nearby deliveries</small></h3>
              <div class="dc-grid">
                <label class="dc-field"><span class="dc-label">Porter radius</span><span class="dc-input"><input name="porterRadiusKm" type="number" min="1" step="1" inputmode="numeric" required /><i>km</i></span></label>
                <label class="dc-field"><span class="dc-label">Base charge</span><span class="dc-input"><i>&#8377;</i><input name="porterBaseFee" type="number" min="0" step="1" inputmode="decimal" required /></span></label>
                <label class="dc-field"><span class="dc-label">Included in base</span><span class="dc-input"><input name="porterIncludedKm" type="number" min="0" step="1" inputmode="decimal" required /><i>km</i></span></label>
                <label class="dc-field"><span class="dc-label">Each extra km</span><span class="dc-input"><i>&#8377;</i><input name="porterPerExtraKm" type="number" min="0" step="1" inputmode="decimal" required /></span></label>
              </div>
            </section>
            <section class="apf-card dc-courier">
              <h3><span aria-hidden="true">📦</span> Courier <small>beyond the Porter radius</small></h3>
              <div class="dc-grid">
                <label class="dc-field"><span class="dc-label">Your state</span><span class="dc-input"><input name="storeState" maxlength="60" placeholder="Tamil Nadu" /></span></label>
                <label class="dc-field"><span class="dc-label">Weight slab</span><span class="dc-input"><input name="slabGrams" type="number" min="50" step="50" inputmode="numeric" required /><i>g</i></span></label>
              </div>
              <div class="dc-zone">
                <h4>Same state</h4>
                <div class="dc-grid">
                  <label class="dc-field"><span class="dc-label">First slab</span><span class="dc-input"><i>&#8377;</i><input name="sameFirst" type="number" min="0" step="1" inputmode="decimal" required /></span></label>
                  <label class="dc-field"><span class="dc-label">Each extra slab</span><span class="dc-input"><i>&#8377;</i><input name="sameExtra" type="number" min="0" step="1" inputmode="decimal" required /></span></label>
                </div>
              </div>
              <div class="dc-zone">
                <h4>Other states</h4>
                <div class="dc-grid">
                  <label class="dc-field"><span class="dc-label">First slab</span><span class="dc-input"><i>&#8377;</i><input name="otherFirst" type="number" min="0" step="1" inputmode="decimal" required /></span></label>
                  <label class="dc-field"><span class="dc-label">Each extra slab</span><span class="dc-input"><i>&#8377;</i><input name="otherExtra" type="number" min="0" step="1" inputmode="decimal" required /></span></label>
                </div>
              </div>
            </section>
            <section class="apf-card dc-weight">
              <h3><span aria-hidden="true">⚖️</span> Weight <small>used until products have weights</small></h3>
              <label class="dc-field"><span class="dc-label">Weight of a product with none set</span><span class="dc-input"><input name="defaultItemWeightGrams" type="number" min="1" step="10" inputmode="numeric" required /><i>g</i></span></label>
              <p class="admin-form-hint">Product weights are per piece and multiplied by the pack size (8 g in a "Pack of 40" = 320 g). The weight above is only for products with no weight set, and is for the whole pack.</p>
            </section>
            <div class="apf-actions"><button class="button button-primary" type="submit">Save delivery settings</button></div>
          </form>
        </section>
        <section class="admin-panel" aria-labelledby="admin-delivery-test-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">Try it</p>
              <h2 id="admin-delivery-test-title">Charge calculator</h2>
            </div>
          </div>
          <p class="admin-form-hint">Uses the values in the form above, even before saving.</p>
          <form class="admin-delivery-form dc-test" id="admin-delivery-test-form">
            <div class="dc-grid">
              <label class="dc-field"><span class="dc-label">Method</span><span class="dc-input"><select name="method"><option value="delivery">Delivery</option><option value="pickup">Pickup</option></select></span></label>
              <label class="dc-field" data-test-delivery><span class="dc-label">Customer PIN code</span><span class="dc-input"><input name="pincode" inputmode="numeric" pattern="[1-9][0-9]{5}" maxlength="6" placeholder="560001" autocomplete="off" /></span></label>
              <label class="dc-field"><span class="dc-label">Total weight</span><span class="dc-input"><select name="weightGrams">
                <option value="250">250 g</option>
                <option value="500" selected>500 g</option>
                <option value="750">750 g</option>
                <option value="1000">1 kg</option>
                <option value="1500">1.5 kg</option>
                <option value="2000">2 kg</option>
                <option value="3000">3 kg</option>
                <option value="5000">5 kg</option>
                <option value="10000">10 kg</option>
                <option value="15000">15 kg</option>
                <option value="20000">20 kg (maximum)</option>
              </select></span><small class="dc-hint">Allowed range: 250 g to 20 kg. 20 kg is the most a 2-wheeler Porter can carry.</small></label>
            </div>
            <button class="button button-primary" type="submit">Calculate charge</button>
          </form>
          <p class="admin-flat-summary" id="admin-delivery-result" role="status" aria-live="polite"></p>
        </section>
      </section>

      <section
        class="admin-tab-panel"
        id="admin-reviews-panel"
        role="tabpanel"
        aria-labelledby="admin-reviews-tab"
        data-admin-panel="reviews"
        tabindex="0"
        hidden
      >
        <section class="admin-panel" aria-labelledby="admin-reviews-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">Social proof</p>
              <h2 id="admin-reviews-title">Customer reviews</h2>
            </div>
          </div>
          <p class="admin-form-hint">Add kind words from customers (WhatsApp, Instagram or Google). Published reviews show on the home page, newest first. Only add reviews customers have given you.</p>
          <form class="rv-form" id="admin-review-form">
            <label class="cat-add-field">Customer name<input class="cat-input" name="name" maxlength="60" required placeholder="Asha" /></label>
            <label class="cat-add-field">Location (optional)<input class="cat-input" name="location" maxlength="60" placeholder="Chennai" /></label>
            <label class="cat-add-field">Rating
              <select class="cat-input" name="rating">
                <option value="5">★★★★★  5 stars</option>
                <option value="4">★★★★☆  4 stars</option>
                <option value="3">★★★☆☆  3 stars</option>
                <option value="2">★★☆☆☆  2 stars</option>
                <option value="1">★☆☆☆☆  1 star</option>
              </select>
            </label>
            <label class="cat-add-field">Product (optional)<input class="cat-input" name="productName" maxlength="80" placeholder="Choco squares" /></label>
            <label class="cat-add-field rv-wide">Review<textarea class="cat-input rv-text" name="reviewText" rows="4" maxlength="600" required placeholder="What did the customer say?"></textarea></label>
            <label class="rv-switch rv-wide"><input name="published" type="checkbox" checked /><span class="rv-switch-track" aria-hidden="true"></span><span>Show on home page</span></label>
            <div class="rv-actions rv-wide">
              <button class="button button-primary" id="admin-review-submit" type="submit">Add review</button>
              <button class="button button-secondary" id="admin-review-cancel" type="button" hidden>Cancel edit</button>
            </div>
          </form>
          <div class="cat-list" id="admin-review-list"></div>
        </section>
      </section>

      <section
        class="admin-tab-panel"
        id="admin-categories-panel"
        role="tabpanel"
        aria-labelledby="admin-categories-tab"
        data-admin-panel="categories"
        tabindex="0"
        hidden
      >
        <section class="admin-panel cat-panel" aria-labelledby="admin-category-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">Catalogue</p>
              <h2 id="admin-category-title">Product categories</h2>
            </div>
          </div>
          <p class="admin-form-hint">Hidden categories disappear from the shop filters and home page, but their products stay in the shop. A category can only be deleted when no product uses it.</p>
          <form class="cat-add" id="admin-category-form">
            <label class="cat-add-field">New category<input class="cat-input" name="name" maxlength="60" required placeholder="Festive specials" /></label>
            <button class="button button-primary" type="submit">Add category</button>
          </form>
          <div class="cat-list" id="admin-category-list"></div>
        </section>
      </section>

      <section
        class="admin-tab-panel"
        id="admin-flavours-panel"
        role="tabpanel"
        aria-labelledby="admin-flavours-tab"
        data-admin-panel="flavours"
        tabindex="0"
        hidden
      >
        <section class="admin-panel cat-panel" aria-labelledby="admin-flavour-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">Catalogue</p>
              <h2 id="admin-flavour-title">Flavours</h2>
            </div>
          </div>
          <p class="admin-form-hint">One list for every product. The extra percentage (can be 0) is added to the price of any product ordered in that flavour. A flavour can only be deleted when no product uses it.</p>
          <form class="cat-add flv-add" id="admin-flavour-form">
            <label class="cat-add-field">New flavour<input class="cat-input" name="name" maxlength="60" required placeholder="Hazelnut" /></label>
            <label class="cat-add-field flv-add-extra">Extra price %<input class="cat-input" name="extraPercent" type="number" inputmode="numeric" min="0" max="500" step="1" value="0" required /></label>
            <button class="button button-primary" type="submit">Add flavour</button>
          </form>
          <div class="cat-list" id="admin-flavour-list"></div>
          <div class="flv-savebar">
            <button class="button button-primary" type="button" id="admin-flavour-save-all">Save all changes</button>
          </div>
        </section>
      </section>

      <section
        class="admin-tab-panel"
        id="admin-customers-panel"
        role="tabpanel"
        aria-labelledby="admin-customers-tab"
        data-admin-panel="customers"
        tabindex="0"
        hidden
      >
        <section class="admin-panel" aria-labelledby="admin-customers-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">Customer book</p>
              <h2 id="admin-customers-title">Customer details</h2>
            </div>
          </div>
          <p class="admin-form-hint" id="admin-customer-form-hint">Add a customer profile or edit saved details. Customer email is the sign-in identity and cannot be changed here.</p>
          <form class="admin-customer-form apf-form" id="admin-customer-form">
            <section class="apf-card"><h3>Contact</h3>
            <label>Name<input name="name" autocomplete="name" maxlength="80" required /></label>
            <label>Phone<input name="phone" type="tel" autocomplete="tel" maxlength="20" required /></label>
            <label>Email (optional)<input name="email" type="email" autocomplete="email" maxlength="120" /></label>
            </section>
            <section class="apf-card"><h3>Address</h3>
            <label class="admin-address-field">Default address<textarea name="address" autocomplete="street-address" rows="2" maxlength="250" required></textarea></label>
            <div class="apf-row apf-row-3">
              <label>City<input name="city" autocomplete="address-level2" maxlength="40" required /></label>
              <label>State<StateSelect /></label>
              <label>PIN code<input name="pincode" inputmode="numeric" autocomplete="postal-code" pattern="[1-9][0-9]{5}" maxlength="6" required /></label>
            </div>
            <p class="location-privacy" data-pincode-status role="status" aria-live="polite"></p>
            </section>
            <div class="admin-customer-form-actions apf-actions">
              <button class="button button-primary" id="admin-customer-submit" type="submit">Save customer</button>
              <button class="button button-secondary" id="admin-customer-cancel-edit" type="button" hidden>Cancel edit</button>
            </div>
          </form>
          <div class="admin-list-tools admin-customer-list-tools">
            <label>Search customers<input id="admin-customer-search" type="search" placeholder="Name, phone, email, or address" autocomplete="off" /></label>
            <p class="admin-list-count" id="admin-customer-count" aria-live="polite"></p>
          </div>
          <div class="admin-customer-list" id="admin-customer-list"></div>
          <nav class="admin-pagination" id="admin-customer-pagination" aria-label="Customer pages"></nav>
        </section>
      </section>

      <section
        class="admin-tab-panel"
        id="admin-create-order-panel"
        role="tabpanel"
        aria-labelledby="admin-create-order-tab"
        data-admin-panel="create-order"
        tabindex="0"
        hidden
      >
        <section class="admin-panel" aria-labelledby="admin-create-order-title">
          <div class="admin-panel-heading">
            <div>
              <p class="eyebrow">In-person, phone, or custom orders</p>
              <h2 id="admin-create-order-title">Create manual order</h2>
            </div>
          </div>
          <div class="admin-edit-banner" id="admin-order-edit-banner" hidden>
            <span id="admin-order-edit-text"></span>
            <button class="account-text-button" id="admin-order-cancel-edit" type="button">Cancel editing</button>
          </div>
          <form class="admin-order-form apf-form" id="admin-order-form">
            <section class="apf-card"><h3>Customer &amp; delivery</h3>
            <label>Find customer<input id="admin-order-customer-search" type="search" placeholder="Search by name, phone, or email" autocomplete="off" /></label>
            <p class="admin-form-hint" id="admin-order-customer-hint"></p>
            <label>Customer<select name="customerId" id="admin-order-customer" required>
              <option value="">Choose a saved customer</option>
            </select></label>
            <label>Delivery address<textarea name="address" id="admin-order-address" rows="2" maxlength="250" required></textarea></label>
            <div class="apf-row apf-row-3">
              <label>City<input name="city" id="admin-order-city" autocomplete="address-level2" maxlength="40" required /></label>
              <label>State<StateSelect id="admin-order-state" /></label>
              <label>PIN code<input name="pincode" id="admin-order-pincode" inputmode="numeric" autocomplete="postal-code" pattern="[1-9][0-9]{5}" maxlength="6" required /></label>
            </div>
            <p class="location-privacy" data-pincode-status role="status" aria-live="polite"></p>
            <div class="admin-order-inline-fields">
              <label>Delivery method<select name="deliveryMethod" required>
                <option value="Porter (manual booking)">Porter (manual booking)</option>
                <option value="Courier (manual booking)">Courier (manual booking)</option>
              </select></label>
              <label>Event date (optional)<input name="eventDate" type="date" /></label>
            </div>
            </section>
            <fieldset class="admin-order-items apf-card">
              <legend>Order items</legend>
              <div id="admin-order-lines"></div>
              <datalist id="admin-custom-products"></datalist>
              <div class="admin-add-buttons">
                <button class="button button-secondary" id="admin-add-line" type="button">Add another item <span aria-hidden="true">+</span></button>
                <button class="account-text-button" id="admin-add-custom-line" type="button">+ Custom item</button>
              </div>
            </fieldset>
            <p class="admin-order-total" id="admin-order-total">Product total: ₹0</p>
            <label class="admin-order-discount">Discount (&#8377;, optional)<input name="discountRupees" id="admin-order-discount" type="number" inputmode="decimal" min="0" step="0.01" placeholder="0" /></label>
                        <label class="admin-order-discount">Delivery charge (&#8377;, optional)<input name="deliveryRupees" id="admin-order-delivery" type="number" inputmode="decimal" min="0" step="0.01" placeholder="0" /></label>
            <fieldset class="admin-order-payment apf-card">
              <legend>Payment</legend>
              <div class="admin-order-inline-fields">
                <label>Payment status<select name="paymentStatus" id="admin-order-payment-status">
                  <option value="unpaid">Unpaid</option>
                  <option value="partial">Partially paid</option>
                  <option value="paid">Paid in full</option>
                </select></label>
                <label id="admin-order-received-label" hidden>Amount received (&#8377;)<input name="amountReceivedRupees" id="admin-order-received" type="number" inputmode="decimal" min="1" step="0.01" /></label>
              </div>
              <p class="admin-form-hint" id="admin-order-due">No payment is initiated here. Record what the customer has already paid you.</p>
            </fieldset>
            <div class="apf-actions"><button class="button button-primary" id="admin-order-submit" type="submit">Create order</button></div>
          </form>
        </section>
      </section>
    </section>

    <section class="admin-invoice-print" id="admin-invoice-print" aria-label="Printable order invoice" hidden></section>
  </main>
</AdminLayout>
