---
import { Image } from "astro:assets";
import type { ProductImage } from "../lib/product-images";

interface Product {
  id: string;
  name: string;
  description: string;
  price: number;
  packSize: string;
  tag: string;
  extraTags?: string[];
  flavours: string[];
  featured?: boolean;
  customizable?: boolean;
}

interface Props {
  product: Product;
  image: ProductImage;
  index: number;
  hidden?: boolean;
}

const { product, image, index, hidden = false } = Astro.props;
const productUrl = `${import.meta.env.BASE_URL}product/${product.id}/`;
---

<article
  class="product-card"
  data-product-id={product.id}
  hidden={hidden}
  data-product-name={product.name.toLowerCase()}
  data-product-search={`${product.name} ${product.description} ${product.tag}`.toLowerCase()}
  data-product-tag={[product.tag, ...(product.extraTags ?? [])].join("|")}
  data-product-price={product.price}
  data-product-featured={product.featured ? "true" : "false"}
  style={`--card-index: ${index}`}
>
  <a class="product-detail-link" href={productUrl} tabindex="-1" aria-hidden="true">
    <div class="product-image-wrap">
      <Image
        src={image}
        alt={`${product.name}, handmade by Chocolate Circle`}
        width={800}
        height={720}
        widths={[320, 480, 640, 800]}
        sizes="(max-width: 620px) 46vw, (max-width: 900px) 44vw, 25vw"
        format="webp"
        quality={82}
        loading="lazy"
        class="product-image"
      />
      <span class="product-tag">{product.tag}</span>
    </div>
  </a>
  <button class="wish-button" type="button" data-wish={product.id} data-wish-name={product.name} aria-pressed="false" aria-label={`Save ${product.name} to wishlist`}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.5s-7.5-4.6-7.5-10A4.5 4.5 0 0 1 12 7.8a4.5 4.5 0 0 1 7.5 2.7c0 5.4-7.5 10-7.5 10z"></path></svg></button>
  <div class="product-copy">
    <div class="product-name-row">
      <h2 class="product-card-title"><a href={productUrl}>{product.name}</a></h2>
      <span class="product-weight">{product.packSize}</span>
    </div>
    <p>{product.description}</p>
    <div class="product-buy-row">
      <div class="product-card-price">
        <strong data-price-now={product.price}>₹{product.price}</strong>
        {product.flavours.length > 0 && <span>{product.flavours.length} flavours</span>}
      </div>
      <a class="add-button" href={productUrl}>Choose options <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
