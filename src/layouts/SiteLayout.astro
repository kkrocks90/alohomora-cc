---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Chocolate Circle — handmade chocolate, made with a little love",
  description = "Small-batch handmade chocolates, lovingly made and wrapped for sharing.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7f1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Chocolate Circle home">
        <span class="wordmark-mark" aria-hidden="true">c</span>
        <span>chocolate <i>circle</i></span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href={`${base}store/`}>Shop all</a>
        <a href={`${base}#chocolates`}>Featured</a>
        <a href={`${base}#our-story`}>Our little story</a>
        <a href={`${base}#kindness`}>Good to know</a>
      </nav>
      <a class="shop-link" href={`${base}store/`}>Shop</a>
      <a class="account-link" href={`${base}account/`}>
        <svg class="account-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="8" r="3.5"></circle>
          <path d="M5 20c.7-3.3 3.2-5 7-5s6.3 1.7 7 5"></path>
        </svg>
        <span data-account-label>Login</span>
      </a>
      <button
        class="menu-toggle"
        id="open-mobile-menu"
        type="button"
        aria-label="Open navigation menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
      <button class="bag-button" id="open-cart" type="button" aria-controls="cart-drawer" aria-expanded="false">
        <span>My bag</span>
        <span class="bag-count" id="bag-count" aria-live="polite">0</span>
      </button>
    </header>

    <div class="mobile-menu-backdrop" id="mobile-menu-backdrop" hidden></div>
    <aside
      class="mobile-menu"
      id="mobile-menu"
      role="dialog"
      aria-modal="true"
      aria-labelledby="mobile-menu-title"
      aria-hidden="true"
    >
      <div class="mobile-menu-heading">
        <p class="eyebrow" id="mobile-menu-title">Find your favourites</p>
        <button class="icon-button" id="close-mobile-menu" type="button" aria-label="Close navigation menu">×</button>
      </div>
      <nav class="mobile-menu-links" aria-label="Mobile navigation">
        <a href={`${base}store/`}>Shop all treats <span aria-hidden="true">↗</span></a>
        <a href={`${base}#chocolates`}>Featured <span aria-hidden="true">↗</span></a>
        <a href={`${base}#our-story`}>Our little story <span aria-hidden="true">↗</span></a>
        <a href={`${base}#kindness`}>Good to know <span aria-hidden="true">↗</span></a>
        <a href={`${base}account/`}><span data-account-label>Login</span> <span aria-hidden="true">↗</span></a>
      </nav>
    </aside>

    <slot />

    <footer class="site-footer">
      <a class="wordmark footer-wordmark" href={base}>
        <span class="wordmark-mark" aria-hidden="true">c</span>
        <span>chocolate <i>circle</i></span>
      </a>
      <p>A little chocolate. A lot of heart.</p>
      <a href={`${base}store/`}>Shop all treats ↑</a>
      <nav class="policy-links" aria-label="Policies">
        <a href={`${base}account/`} data-account-label>Login</a>
        <a href={`${base}terms-and-conditions/`}>Terms &amp; Conditions</a>
        <a href={`${base}privacy-policy/`}>Privacy Policy</a>
        <a href={`${base}shipping-policy/`}>Shipping Policy</a>
      </nav>
      <small>© {new Date().getFullYear()} Chocolate Circle. Made in small batches.</small>
    </footer>

    <div class="drawer-backdrop" id="drawer-backdrop" hidden></div>
    <aside class="cart-drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="cart-title" aria-hidden="true">
      <div class="drawer-header">
        <div>
          <p class="eyebrow">A treat for later</p>
          <h2 id="cart-title">Your little bag</h2>
        </div>
        <button class="icon-button" id="close-cart" type="button" aria-label="Close shopping bag">×</button>
      </div>
      <p class="empty-cart" id="empty-cart">Your bag is waiting for something lovely.</p>
      <div class="cart-items" id="cart-items"></div>
      <div class="cart-summary" id="cart-summary" hidden>
        <div class="subtotal-row"><span>Subtotal</span><strong id="cart-total">₹0</strong></div>
        <p class="delivery-note">Delivery details and any delivery charge are confirmed separately.</p>
        <a class="button button-primary checkout-button" id="proceed-to-checkout" href={`${base}checkout/`}>
          Continue to checkout <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="payment-footnote">Secure payment is available on the separate checkout page after sign-in.</p>
    </aside>
    <script>
      import "../scripts/navigation";
      import "../scripts/storefront";
    </script>
  </body>
</html>
