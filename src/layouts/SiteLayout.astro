---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  socialImage?: string;
  socialImageAlt?: string;
  noIndex?: boolean;
}

const {
  title = "Chocolate Circle — handmade chocolate, made with a little love",
  description = "Small-batch handmade chocolates, lovingly made and wrapped for sharing.",
  socialImage = "/social-share.jpg",
  socialImageAlt = "Chocolate Circle handmade chocolates and small-batch treats",
  noIndex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(socialImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#faf7f1" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chocolate Circle" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Chocolate Circle home">
        <span class="wordmark-mark" aria-hidden="true">c</span>
        <span>chocolate <i>circle</i></span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href={`${base}store/`}>Shop all</a>
        <a href={`${base}#chocolates`}>Featured</a>
        <a href={`${base}about/`}>About us</a>
        <a href={`${base}#kindness`}>Good to know</a>
      </nav>
      <a class="shop-link" href={`${base}store/`}>Shop</a>
      <a class="account-link" href={`${base}account/`}>
        <svg class="account-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="8" r="3.5"></circle>
          <path d="M5 20c.7-3.3 3.2-5 7-5s6.3 1.7 7 5"></path>
        </svg>
        <span data-account-label>Login</span>
      </a>
      <button
        class="menu-toggle"
        id="open-mobile-menu"
        type="button"
        aria-label="Open navigation menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
      <button class="bag-button" id="open-cart" type="button" aria-controls="cart-drawer" aria-expanded="false">
        <span>My bag</span>
        <span class="bag-count" id="bag-count" aria-live="polite">0</span>
      </button>
    </header>

    <div class="mobile-menu-backdrop" id="mobile-menu-backdrop" hidden></div>
    <aside
      class="mobile-menu"
      id="mobile-menu"
      role="dialog"
      aria-modal="true"
      aria-labelledby="mobile-menu-title"
      aria-hidden="true"
    >
      <div class="mobile-menu-heading">
        <p class="eyebrow" id="mobile-menu-title">Find your favourites</p>
        <button class="icon-button" id="close-mobile-menu" type="button" aria-label="Close navigation menu">×</button>
      </div>
      <nav class="mobile-menu-links" aria-label="Mobile navigation">
        <a href={`${base}store/`}>Shop all treats <span aria-hidden="true">↗</span></a>
        <a href={`${base}#chocolates`}>Featured <span aria-hidden="true">↗</span></a>
        <a href={`${base}about/`}>About us <span aria-hidden="true">↗</span></a>
        <a href={`${base}#kindness`}>Good to know <span aria-hidden="true">↗</span></a>
        <a href={`${base}account/`}><span data-account-label>Login</span> <span aria-hidden="true">↗</span></a>
      </nav>
      <div class="mobile-menu-footer">
        <p>A little chocolate. A lot of heart.</p>
        <div class="mobile-menu-actions">
          <a
            class="mobile-menu-cta"
            href="https://wa.me/919500868468?text=Hi%20Chocolate%20Circle%2C%20I%27d%20like%20to%20ask%20about%20your%20chocolates."
            target="_blank"
            rel="noopener noreferrer"
          >WhatsApp us</a>
          <a
            class="mobile-menu-cta mobile-menu-cta-light"
            href="https://www.instagram.com/achocolatecircle/"
            target="_blank"
            rel="noopener noreferrer"
          >Instagram</a>
        </div>
      </div>
    </aside>

    <slot />

    <footer class="site-footer">
      <a class="wordmark footer-wordmark" href={base}>
        <span class="wordmark-mark" aria-hidden="true">c</span>
        <span>chocolate <i>circle</i></span>
      </a>
      <p>A little chocolate. A lot of heart.</p>
      <a href={`${base}store/`}>Shop all treats ↑</a>
      <nav class="footer-social-links" aria-label="Connect with Chocolate Circle">
        <a
          href="https://www.instagram.com/achocolatecircle/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Follow Chocolate Circle on Instagram"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" class="social-icon-fill"></circle>
          </svg>
          <span>Instagram</span>
        </a>
        <a
          href="https://wa.me/919500868468?text=Hi%20Chocolate%20Circle%2C%20I%27d%20like%20to%20ask%20about%20your%20chocolates."
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Chat with Chocolate Circle on WhatsApp"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.4-4.7a8.5 8.5 0 1 1 16.1-4.1Z"></path>
            <path d="M9 8.2c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.8 1.9c.1.2.1.4 0 .6l-.6.7c-.2.2-.2.4-.1.6.6 1 1.4 1.8 2.4 2.4.2.1.4.1.6-.1l.7-.8c.2-.2.4-.2.6-.1l1.8.9c.3.1.4.3.4.5 0 .3-.2 1.2-.8 1.6-.5.4-1.2.6-2 .4-1.1-.2-2.5-.8-4-2.2-1.8-1.6-2.9-3.6-3.1-4.7-.2-.9.1-1.5.5-1.9.4-.4.9-.6 1.1-.6Z"></path>
          </svg>
          <span>WhatsApp</span>
        </a>
      </nav>
      <nav class="policy-links" aria-label="Shop information and policies">
        <a href={`${base}account/`} data-account-label>Login</a>
        <a href={`${base}about/`}>About us</a>
        <a href={`${base}terms-and-conditions/`}>Terms &amp; Conditions</a>
        <a href={`${base}privacy-policy/`}>Privacy Policy</a>
        <a href={`${base}shipping-policy/`}>Shipping Policy</a>
      </nav>
      <small>© {new Date().getFullYear()} Chocolate Circle. Made in small batches.</small>
    </footer>

    <nav class="tab-bar" id="tab-bar" aria-label="Quick navigation">
      <a href={base} data-tab-path="/">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11 12 4l8 7v8.5a.5.5 0 0 1-.5.5H15v-6H9v6H4.5a.5.5 0 0 1-.5-.5Z"></path></svg>
        <span>Home</span>
      </a>
      <a href={`${base}store/`} data-tab-path="/store/">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1.5"></rect><rect x="13" y="4" width="7" height="7" rx="1.5"></rect><rect x="4" y="13" width="7" height="7" rx="1.5"></rect><rect x="13" y="13" width="7" height="7" rx="1.5"></rect></svg>
        <span>Shop</span>
      </a>
      <button type="button" id="tab-bag" aria-label="Open your shopping bag">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6Z"></path><path d="M9 8V6.5a3 3 0 0 1 6 0V8"></path></svg>
        <span>Bag</span>
        <b class="tab-bag-count" id="tab-bag-count" hidden>0</b>
      </button>
      <a href={`${base}account/`} data-tab-path="/account/">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"></circle><path d="M5 20c.7-3.3 3.2-5 7-5s6.3 1.7 7 5"></path></svg>
        <span data-account-label>Login</span>
      </a>
    </nav>

    <a
      class="whatsapp-float"
      href="https://wa.me/919500868468?text=Hi%20Chocolate%20Circle%2C%20I%27d%20like%20to%20ask%20about%20your%20chocolates."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with Chocolate Circle on WhatsApp"
      title="Chat with Chocolate Circle on WhatsApp"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.4-4.7a8.5 8.5 0 1 1 16.1-4.1Z"></path>
        <path d="M9 8.2c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.8 1.9c.1.2.1.4 0 .6l-.6.7c-.2.2-.2.4-.1.6.6 1 1.4 1.8 2.4 2.4.2.1.4.1.6-.1l.7-.8c.2-.2.4-.2.6-.1l1.8.9c.3.1.4.3.4.5 0 .3-.2 1.2-.8 1.6-.5.4-1.2.6-2 .4-1.1-.2-2.5-.8-4-2.2-1.8-1.6-2.9-3.6-3.1-4.7-.2-.9.1-1.5.5-1.9.4-.4.9-.6 1.1-.6Z"></path>
      </svg>
    </a>

    <div class="drawer-backdrop" id="drawer-backdrop" hidden></div>
    <aside class="cart-drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="cart-title" aria-hidden="true">
      <div class="drawer-header">
        <div>
          <p class="eyebrow">A treat for later</p>
          <h2 id="cart-title">Your little bag</h2>
        </div>
        <button class="icon-button" id="close-cart" type="button" aria-label="Close shopping bag">×</button>
      </div>
      <p class="empty-cart" id="empty-cart">Your bag is waiting for something lovely.</p>
      <div class="cart-items" id="cart-items"></div>
      <div class="cart-summary" id="cart-summary" hidden>
        <div class="subtotal-row"><span>Subtotal</span><strong id="cart-total">₹0</strong></div>
        <p class="delivery-note">Delivery details and any delivery charge are confirmed separately.</p>
        <a class="button button-primary checkout-button" id="proceed-to-checkout" href={`${base}checkout/`}>
          Continue to checkout <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="payment-footnote">Secure payment is available on the separate checkout page after sign-in.</p>
    </aside>
    <script>
      import "../scripts/navigation";
      import "../scripts/storefront";
    </script>
  </body>
</html>
