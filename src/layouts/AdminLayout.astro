---
import "../styles/global.css";
import "../styles/admin.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Chocolate Circle Admin",
  description = "Private Chocolate Circle order management.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7f1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="admin-header">
      <a class="wordmark" href={`${import.meta.env.BASE_URL}admin/`}>
        <img class="wordmark-mark" src={`${import.meta.env.BASE_URL}logo-mark.png`} alt="Chocolate Circle logo" width="40" height="40" />
        <span>chocolate <i>circle</i></span>
      </a>
      <span class="admin-header-label">Order management</span>
      <button class="icon-button admin-refresh-icon admin-header-refresh" id="admin-header-refresh" type="button" aria-label="Refresh" title="Refresh" hidden>&#8635;</button>
      <button
        class="menu-toggle admin-header-menu"
        id="admin-menu-toggle"
        type="button"
        aria-label="Open admin menu"
        aria-controls="admin-tabs"
        aria-expanded="false"
        hidden
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </header>
    <slot />
    <script>
      import "../scripts/admin";
    </script>
  </body>
</html>
